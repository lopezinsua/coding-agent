# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: anthropic | groq | ollama | openai
LLM_PROVIDER=groq

# Optional: override the default model for the chosen provider
# LLM_MODEL=llama-3.3-70b-versatile

# ── API Keys (only the one matching LLM_PROVIDER is required) ─────────────────

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Groq — free tier at https://console.groq.com
GROQ_API_KEY=gsk_...

# OpenAI (if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Ollama needs no key — just run `ollama serve` locally

# ── GitHub (for opening PRs) ──────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=lopezinsua
